{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "egbv/1"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "actual",
        "simulation"
      ]
    },
    "bug_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hypothesis": {
      "type": "object",
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "basis_type": {
          "enum": [
            "product_requirement",
            "standard",
            "inference",
            "unknown"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "claim",
        "expected",
        "basis_type",
        "basis"
      ],
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "properties": {
        "initial_state": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "object"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "initial_state",
        "environment",
        "steps"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "COMPLETED",
            "ERROR",
            "NOT_RUN"
          ]
        },
        "record_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "record_path"
      ],
      "additionalProperties": false
    },
    "reproduction": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "REPRODUCED",
            "NOT_REPRODUCED",
            "UNKNOWN"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "fact": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "fact",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "time": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "sha256",
          "time"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "access": {
            "enum": [
              "retrieved",
              "unavailable",
              "empty-body"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "application": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "url",
          "section",
          "kind",
          "access",
          "statement",
          "application"
        ],
        "additionalProperties": false
      }
    },
    "judgment": {
      "type": "object",
      "properties": {
        "verdict": {
          "enum": [
            "CONFIRMED",
            "NOT_A_BUG",
            "INCONCLUSIVE"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "alternatives_considered": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "verdict",
        "reason",
        "evidence_ids",
        "source_ids",
        "alternatives_considered"
      ],
      "additionalProperties": false
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "candidate_id",
    "mode",
    "bug_types",
    "hypothesis",
    "scenario",
    "execution",
    "reproduction",
    "observations",
    "evidence",
    "sources",
    "judgment",
    "uncertainties",
    "next_steps"
  ],
  "additionalProperties": false
}
