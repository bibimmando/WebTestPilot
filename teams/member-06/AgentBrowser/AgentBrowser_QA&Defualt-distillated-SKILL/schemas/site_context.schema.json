{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "wtp.site_context/1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "format": "uri"
    },
    "authorization": {
      "type": "object",
      "properties": {
        "origins": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "actions_reviewed": {
          "const": true
        }
      },
      "required": [
        "origins",
        "basis",
        "actions_reviewed"
      ],
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "crawler_context": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "target",
    "authorization",
    "requirements",
    "crawler_context"
  ],
  "additionalProperties": false
}